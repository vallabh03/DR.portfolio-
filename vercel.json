{
  "cleanUrls": true,
  "crons": [{ "path": "/api/cron/retry-notifications", "schedule": "0 3 * * *" }],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "dr-portfolio-kohl.vercel.app" }],
      "destination": "https://www.drabhinavthaduri.in/:path*",
      "permanent": true
    },
    { "source": "/credentials", "destination": "/research", "permanent": true },
    { "source": "/approach", "destination": "/about", "permanent": true },
    { "source": "/testimonials", "destination": "/", "permanent": true },
    { "source": "/experience", "destination": "/about", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/optimized/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
