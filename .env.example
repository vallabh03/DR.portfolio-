# Consultation form -> WhatsApp (server-side only)
#
# These are read by api/consultation.ts on the server. None of them start with
# VITE_, so Vite never puts them in the browser bundle. Do not add a VITE_
# prefix to any of them.
#
# Production: add the real values in Vercel > Project > Settings > Environment
# Variables. Local development: copy this file to .env.local (git-ignored) and
# fill it in there. Never put real values in this file.

# System User access token from Meta Business settings (secret)
WHATSAPP_ACCESS_TOKEN=

# "Phone number ID" of the sending number (WhatsApp > API Setup in the Meta app)
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (for reference; not needed to send)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# The practice's WhatsApp number that receives requests, country code first, digits only
WHATSAPP_RECIPIENT_NUMBER=

# The approved message template (see docs/SETUP.md for its exact text)
WHATSAPP_TEMPLATE_NAME=consultation_request
WHATSAPP_TEMPLATE_LANGUAGE=en

# Optional: Graph API version (defaults to v23.0)
WHATSAPP_API_VERSION=

# Optional: comma-separated sites allowed to post the form, e.g. https://www.example.com
# When empty, only the site the request was sent to is allowed.
ALLOWED_ORIGINS=

# Local development only (ignored in production): sent | failed
# Replaces the call to Meta so the form's success and failure states can be tried.
WHATSAPP_DEV_MOCK=
