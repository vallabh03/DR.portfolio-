# Consultation bookings: Supabase + WhatsApp (see docs/BOOKINGS.md)
#
# Server-only values have no VITE_ prefix, so Vite never puts them in the
# browser bundle. Never add a VITE_ prefix to a secret.
#
# Production: add the real values in Vercel > Project > Settings > Environment
# Variables. Local development: copy this file to .env.local (git-ignored) and
# fill it in there. Never put real values in this file.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Server functions (api/): project URL and the service-role key (SECRET).
# SUPABASE_SECRET_KEY is accepted as another name for the service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Meta WhatsApp Cloud API ───────────────────────────────────────────────────
# System User access token from Meta Business settings (SECRET)
WHATSAPP_ACCESS_TOKEN=

# "Phone number ID" of the sending number (WhatsApp > API Setup in the Meta app)
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (for reference; not needed to send)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# The doctor's WhatsApp number that receives new bookings, country code first
WHATSAPP_RECIPIENT_NUMBER=

# Approved message template for the doctor's notification (exact text in docs/BOOKINGS.md)
WHATSAPP_TEMPLATE_NAME=new_booking_request
WHATSAPP_TEMPLATE_LANGUAGE=en

# Optional: Graph API version (defaults to v23.0)
WHATSAPP_API_VERSION=

# Webhook (/api/whatsapp-webhook) for delivery receipts and the booking assistant:
# the Meta app secret (SECRET) and a verify token you choose (SECRET)
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Optional: extra numbers allowed to ask the booking assistant, comma-separated,
# country code first. The doctor's number (WHATSAPP_RECIPIENT_NUMBER) is always allowed.
WHATSAPP_ALLOWED_NUMBERS=

# Daily retry of failed notifications (/api/cron/retry-notifications): any long
# random text; Vercel sends it with each scheduled call (SECRET)
CRON_SECRET=

# ── Notifications (docs/BOOKINGS.md, section 7) ──────────────────────────────
# Which messages are sent, with which templates, is set in the Supabase table
# notification_settings, not here.
# Provider for template messages: leminai or meta. Empty: leminai when
# LEMINAI_API_KEY is set, otherwise meta.
WHATSAPP_PROVIDER=
# Leminai API key (SECRET) and, optionally, its API address
LEMINAI_API_KEY=
LEMINAI_API_URL=
# Secret the Supabase database webhook sends to /api/booking-events (SECRET)
BOOKING_EVENTS_SECRET=

# Optional: comma-separated sites allowed to post the form, e.g. https://www.drabhinavthaduri.in
# When empty, only the site the request was sent to is allowed.
ALLOWED_ORIGINS=

# Local development only (ignored in production): sent | failed
# Runs the form without Supabase or Meta: bookings in memory, WhatsApp replaced by a stand-in.
BOOKING_DEV_MOCK=

# ── Search ────────────────────────────────────────────────────────────────────
# Optional: Google Search Console "HTML tag" verification code (only the content value).
# Added to every page at build time. Not needed if you verify the domain by DNS.
GOOGLE_SITE_VERIFICATION=
